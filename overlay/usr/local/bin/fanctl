#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""ZELUX 风扇根助手：/run/zelux/fan.sock 的另一端。

为什么要单独一个 root 进程：
zeluxd 以 zelux 用户跑（网页被攻破最多丢照片），而 /sys/class/pwm 只有 root 能写。
把"开通道 / 写 duty"关进这个只认 JSON 的小服务，攻击面就是一行 `{"op":"set",...}`。

协议（一行一个 JSON，与 software/zeluxd/hal/radxa_fan.py 的 FanHelper 严格对齐）：
    请求  {"op":"set","index":0,"pwm":14,"duty":40000,"period":40000}
    应答  {"ok":true,"index":0,"duty":40000,"pct":100,"period":40000}
    请求  {"op":"get","index":1}
    应答  {"ok":true,"index":1,"pct":60,"rpm":3240,"duty":24000,"period":40000}
    失败  {"ok":false,"error":"人话"}
    （另有 "ping" / "status" / "selftest"，给命令行排查用）

跑在哪：板子上，systemd 以 root 起（zelux-fand.service），socket 0660 root:zelux。
会改动什么：只写 /sys/class/pwm/**（以及测速时 /sys/class/gpio/gpio150），不碰别的。
硬性约定：进程退出时不关风扇（关机前后那几秒正是最热的时候）。

命令行：
    fanctl --serve                  # 默认：起 socket 服务
    fanctl --status                 # 打印两颗风扇当前状态后退出
    fanctl --selftest               # 全速 1 秒 → 读转速 → 回原值
    fanctl --stdin                  # 从标准输入逐行读 JSON，回显应答（SSH 里手测用）
    fanctl --once '{"op":"set","index":0,"duty":20000}'
"""
from __future__ import annotations

import argparse
import asyncio
import json
import logging
import os
import signal
import sys
import time
from pathlib import Path
from typing import Any

try:                                  # grp 只有 Unix 有；没有它只是设不了 socket 的组
    import grp
except ImportError:                   # pragma: no cover
    grp = None  # type: ignore[assignment]

CONFIG_PATH = Path("/etc/zelux/zelux.toml")
PWM_ROOT = Path("/sys/class/pwm")
GPIO_ROOT = Path("/sys/class/gpio")

DEFAULT_PERIOD_NS = 40000           # 25 kHz
MIN_PERIOD_NS = 1000
MAX_PERIOD_NS = 10_000_000
DEFAULT_PCT = 60
TACH_WINDOW_S = 0.4                 # 短窗口：web 端 1.5 秒超时，不能在这里耗 1 秒
PULSES_PER_REV = 2
SOCKET_GROUP = "zelux"

log = logging.getLogger("fanctl")


# ---------------------------------------------------------------- 配置
def load_config(path: Path) -> dict:
    if not path.exists():
        log.warning("没有 %s，用内置默认值（两颗风扇 / 25 kHz / 60%%）", path)
        return {}
    try:
        import tomllib
    except ModuleNotFoundError:
        log.warning("Python 没有 tomllib（需要 3.11+），用内置默认值")
        return {}
    with path.open("rb") as fh:
        try:
            return tomllib.load(fh)
        except Exception as exc:
            log.error("%s 语法错，用内置默认值：%s", path, exc)
            return {}


FALLBACK_CHANNELS = [
    {"name": "顶部风扇", "pwm": 14, "gpio": 116, "tach": 0, "chip": 3, "channel": 2},
    {"name": "主板散热", "pwm": 12, "gpio": 149, "tach": 150, "chip": 3, "channel": 0},
]


def clamp_int(value: Any, lo: int, hi: int, default: int) -> int:
    try:
        return max(lo, min(hi, int(value)))
    except (TypeError, ValueError):
        return default


# ---------------------------------------------------------------- PWM 通道
class PwmChannel:
    """一个 PWM 输出。

    解析顺序（宁可报错也不猜，控制错脚比控制不了更糟）：
    1. 配置里写死的 chip/channel（真机确认过的唯一可靠来源）；
    2. 内核已经把通道导出成 `pwm<全局号>`（老内核的全局编号风格）；
    3. 放弃，返回人话原因。
    """

    def __init__(self, spec: dict, period_ns: int) -> None:
        self.name = str(spec.get("name") or "风扇")
        self.pwm = clamp_int(spec.get("pwm"), 0, 999, -1)
        self.gpio = clamp_int(spec.get("gpio"), -1, 9999, -1)
        self.tach = clamp_int(spec.get("tach"), 0, 9999, 0)
        self.chip = clamp_int(spec.get("chip"), -1, 99, -1)
        self.channel = clamp_int(spec.get("channel"), -1, 99, -1)
        self.period_ns = period_ns
        self._path: Path | None = None
        self._duty = 0
        self._why = ""

    # -- 解析 --------------------------------------------------------
    def path(self) -> Path | None:
        if self._path is not None and self._path.exists():
            return self._path
        self._path = None
        if self.chip >= 0 and self.channel >= 0:
            self._path = self._export(self.chip, self.channel)
            if self._path:
                return self._path
        if self.pwm >= 0:
            for chip in self._chips():
                direct = chip / f"pwm{self.pwm}"
                if direct.exists():
                    self._path = direct
                    return self._path
        self._why = (f"{self.name}: 找不到 PWM 通道（配置 chip={self.chip}/channel={self.channel}，"
                     f"全局号 pwm{self.pwm}）。真机确认后改 /etc/zelux/zelux.toml")
        return None

    @staticmethod
    def _chips() -> list[Path]:
        if not PWM_ROOT.exists():
            return []
        chips = []
        for p in PWM_ROOT.glob("pwmchip*"):
            try:
                chips.append((int(p.name[7:]), p))
            except ValueError:
                continue
        return [p for _, p in sorted(chips)]

    @staticmethod
    def _export(chip_no: int, channel: int) -> Path | None:
        chip = PWM_ROOT / f"pwmchip{chip_no}"
        node = chip / f"pwm{channel}"
        if node.exists():
            return node
        export = chip / "export"
        if not export.exists():
            return None
        try:
            # 已经 export 过会返回 EBUSY，属于正常情况
            export.write_text(str(channel), "ascii")
        except OSError as exc:
            log.debug("export pwmchip%s/pwm%s 失败：%s", chip_no, channel, exc)
        for _ in range(20):
            if node.exists():
                return node
            time.sleep(0.01)
        return None

    # -- 读写 --------------------------------------------------------
    def _write(self, name: str, value: int) -> None:
        node = self.path()
        if node is None:
            raise RuntimeError(self._why or f"{self.name}: PWM 通道不可用")
        try:
            (node / name).write_text(str(int(value)), "ascii")
        except OSError as exc:
            raise RuntimeError(f"{self.name}: 写 {name}={value} 失败：{exc}") from None

    def apply(self, duty: int, period: int | None = None) -> int:
        period = clamp_int(period or self.period_ns, MIN_PERIOD_NS, MAX_PERIOD_NS, self.period_ns)
        duty = max(0, min(period, int(duty)))
        # 顺序有讲究：enable=1 时改 period 有些内核直接 EBUSY，
        # 而 duty > period 写 period 会被 EINVAL 顶回来，所以先把 duty 归零。
        try:
            self._write("enable", 0)
        except RuntimeError:
            pass
        # 必须读**内核里真实的** period 来比：刚 export 的通道 period 是 0，
        # 此时只写 duty 会被内核拒掉（EINVAL），风扇一动不动还看不出为什么。
        if self._read_int("period", 0) != period:
            self._write("duty_cycle", 0)
            self._write("period", period)
        self.period_ns = period
        self._write("duty_cycle", duty)
        self._write("enable", 1)
        self._duty = duty
        return duty

    def _read_int(self, name: str, default: int = 0) -> int:
        node = self.path()
        if node is None:
            return default
        try:
            return int((node / name).read_text("ascii").strip())
        except (OSError, ValueError):
            return default

    def read_duty(self) -> int:
        return self._read_int("duty_cycle", self._duty)

    def pct(self) -> int:
        period = max(1, self.period_ns)
        return int(round(max(0, min(period, self.read_duty())) * 100.0 / period))

    def rpm(self) -> int | None:
        """只有带测速线的风扇才有值；没有就返回 None（不猜，不写 0）。"""
        if not self.tach:
            return None
        hz = measure_hz(self.tach, TACH_WINDOW_S)
        if hz is None:
            return None
        return int(round(hz * 60.0 / PULSES_PER_REV))

    def info(self) -> dict:
        node = self.path()
        return {"name": self.name, "pwm": self.pwm, "gpio": self.gpio, "tach": self.tach,
                "period_ns": self.period_ns, "duty": self.read_duty(), "pct": self.pct(),
                "path": str(node) if node else None, "why": "" if node else self._why}


# ---------------------------------------------------------------- 测速
def measure_hz(gpio: int, window: float = TACH_WINDOW_S) -> float | None:
    """在 sysfs 上数上升沿。

    故意不用 libgpiod：gpiod 的 request 是独占的，fanctl 一占，
    zeluxd 里 radxa_fan.py 自己的测速就永远拿不到线（rpm 变 null，还查不出原因）。
    sysfs 两边都能读，代价是 0.4 秒的忙轮询 —— 只在有人问转速时才发生。
    """
    node = GPIO_ROOT / f"gpio{gpio}"
    try:
        if not node.exists():
            (GPIO_ROOT / "export").write_text(str(gpio), "ascii")
            for _ in range(10):
                if node.exists():
                    break
                time.sleep(0.01)
        (node / "direction").write_text("in", "ascii")
    except OSError as exc:
        log.debug("GPIO%d 不可用：%s", gpio, exc)
        return None

    value = node / "value"
    try:
        prev = value.read_text("ascii").strip()
    except OSError:
        return None
    edges = 0
    end = time.monotonic() + window
    while time.monotonic() < end:
        try:
            cur = value.read_text("ascii")
        except OSError:
            return None
        cur = cur.strip()
        if cur == "1" and prev == "0":
            edges += 1
        prev = cur
    return edges / window


# ---------------------------------------------------------------- 服务
class Helper:
    def __init__(self, cfg: dict) -> None:
        fan = cfg.get("fan") or {}
        self.socket_path = str(fan.get("socket") or "/run/zelux/fan.sock")
        period = clamp_int(fan.get("period_ns"), MIN_PERIOD_NS, MAX_PERIOD_NS, DEFAULT_PERIOD_NS)
        self.default_pct = clamp_int(fan.get("default_pct"), 0, 100, DEFAULT_PCT)
        specs = fan.get("channel") or FALLBACK_CHANNELS
        self.fans = [PwmChannel(dict(s), period) for s in specs]
        log.info("装载 %d 颗风扇，period=%d ns，默认 %d%%", len(self.fans), period, self.default_pct)

    def fan(self, index: Any) -> PwmChannel:
        try:
            idx = int(index)
        except (TypeError, ValueError):
            raise ValueError(f"index 必须是整数，收到 {index!r}") from None
        if not 0 <= idx < len(self.fans):
            raise ValueError(f"没有第 {idx} 号风扇（这台机器只有 {len(self.fans)} 颗）")
        return self.fans[idx]

    def handle(self, req: dict) -> dict:
        """对外只有这一个入口，且保证**永远返回 dict、永远不抛**。

        调用方（zeluxd 的 FanHelper）把 error 字段翻译成"人话 + 修复建议"，
        所以这里的每一条错误信息都要能直接给人看。
        """
        try:
            return self._dispatch(req)
        except (ValueError, RuntimeError) as exc:
            return {"ok": False, "error": str(exc)}
        except Exception as exc:                # 兜底：绝不让异常穿过 socket
            log.exception("处理请求失败")
            return {"ok": False, "error": f"内部错误：{exc}"}

    def _dispatch(self, req: dict) -> dict:
        op = str(req.get("op") or "").strip().lower()
        if op == "ping":
            return {"ok": True, "pong": True, "fans": len(self.fans)}
        if op == "status":
            return {"ok": True, "items": [f.info() for f in self.fans]}
        if op == "set":
            fan = self.fan(req.get("index", 0))
            period = req.get("period")
            if req.get("duty") is not None:
                duty = clamp_int(req.get("duty"), 0, MAX_PERIOD_NS, 0)
            elif req.get("pct") is not None:
                duty = int(round(clamp_int(req.get("pct"), 0, 100, 0) / 100.0 * fan.period_ns))
            else:
                # 只给 index 不给 duty 的请求不合法：宁可报错，也不要把风扇拧到 0 或 100
                return {"ok": False, "error": "set 需要 duty 或 pct"}
            duty = fan.apply(duty, period)
            return {"ok": True, "index": req.get("index", 0), "duty": duty,
                    "pct": fan.pct(), "period": fan.period_ns}
        if op == "get":
            fan = self.fan(req.get("index", 0))
            return {"ok": True, "index": req.get("index", 0), "pct": fan.pct(),
                    "rpm": fan.rpm(), "duty": fan.read_duty(), "period": fan.period_ns}
        if op == "selftest":
            return self.selftest(req.get("index"))
        return {"ok": False, "error": f"不支持的 op：{op!r}（可用 set/get/status/ping/selftest）"}

    def selftest(self, index: Any = None) -> dict:
        targets = [index] if index is not None else range(len(self.fans))
        results = []
        for i in targets:
            fan = self.fan(i)
            prev = fan.pct()
            try:
                fan.apply(fan.period_ns)
                time.sleep(1.0)
                rpm = fan.rpm()
            finally:
                fan.apply(int(round(prev / 100.0 * fan.period_ns)))
            if rpm is None:
                results.append({"index": i, "name": fan.name, "ok": None,
                                "reason": "这颗没有测速线，只能靠听/手感判断"})
            else:
                results.append({"index": i, "name": fan.name, "ok": rpm > 300, "rpm": rpm})
        return {"ok": all(r["ok"] is not False for r in results), "items": results}

    def boot_apply(self) -> None:
        """开机先给个安全风速。zeluxd 起来后按温度曲线接管，这里只是兜底。"""
        duty = int(round(self.default_pct / 100.0 * DEFAULT_PERIOD_NS))
        for fan in self.fans:
            try:
                fan.apply(duty)
                log.info("%s -> %d%%", fan.name, self.default_pct)
            except Exception as exc:
                log.warning("%s 初始调速失败：%s", fan.name, exc)


# ---------------------------------------------------------------- socket
def bind_socket(path: str) -> None:
    p = Path(path)
    p.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(p.parent, 0o750)
    except OSError:
        pass
    if p.exists():
        try:
            p.unlink()              # 上次崩溃留下的死 socket
        except OSError as exc:
            raise SystemExit(f"删不掉旧 socket {p}：{exc}")
    os.umask(0o007)


def chown_socket(path: str) -> None:
    mode = 0o660
    uid = os.getuid()
    gid = -1
    try:
        if grp is None:
            raise KeyError(SOCKET_GROUP)
        gid = grp.getgrnam(SOCKET_GROUP).gr_gid
    except KeyError:
        # 组不存在说明安装不完整。目录是 0750 root:root，外人进不来，
        # 所以这里退回 0666 保证 zeluxd 能用，同时在日志里喊一声。
        log.error("没有 %s 组：socket 退回 0666（只靠目录权限保护），"
                  "请检查 usermod -aG %s zelux", SOCKET_GROUP, SOCKET_GROUP)
        mode = 0o666
    try:
        os.chown(path, uid, gid)
        os.chmod(path, mode)
    except OSError as exc:
        log.error("设置 socket 权限失败：%s", exc)


def safe_handle(helper: "Helper", req: Any) -> dict:
    """唯一一处把异常翻译成 {"ok":false} 的地方。

    socket / stdin / --once 三条入口都走它，否则总有一天会有一条忘了兜底，
    然后一个 500 行 traceback 把 zeluxd 的 readline 等成超时。
    """
    try:
        if not isinstance(req, dict):
            return {"ok": False, "error": "请求必须是 JSON 对象"}
        return helper.handle(req)
    except (ValueError, RuntimeError) as exc:
        return {"ok": False, "error": str(exc)}
    except Exception as exc:                    # 最后一道闸
        log.exception("处理请求失败")
        return {"ok": False, "error": f"内部错误：{exc}"}


async def serve(helper: Helper) -> None:
    stop = asyncio.Event()

    async def on_client(reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
        try:
            while True:
                line = await reader.readline()
                if not line:
                    break
                line = line.strip()
                if not line:
                    continue
                try:
                    req = json.loads(line.decode("utf-8", "replace"))
                except ValueError as exc:
                    res = {"ok": False, "error": f"JSON 解析失败：{exc}"}
                else:
                    res = safe_handle(helper, req)
                writer.write((json.dumps(res, ensure_ascii=False) + "\n").encode("utf-8"))
                try:
                    await writer.drain()
                except OSError:
                    break
        except (ConnectionResetError, BrokenPipeError):
            pass
        finally:
            try:
                writer.close()
            except Exception:
                pass

    bind_socket(helper.socket_path)
    server = await asyncio.start_unix_server(on_client, path=helper.socket_path)
    chown_socket(helper.socket_path)
    log.info("监听 %s", helper.socket_path)

    loop = asyncio.get_running_loop()
    for sig in (signal.SIGTERM, signal.SIGINT):
        try:
            loop.add_signal_handler(sig, stop.set)
        except (NotImplementedError, RuntimeError):
            pass

    async with server:
        await stop.wait()
    log.info("退出（风扇保持当前风速）")


# ---------------------------------------------------------------- 命令行
def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="fanctl", description="ZELUX 风扇根助手")
    ap.add_argument("--config", default=str(CONFIG_PATH))
    ap.add_argument("--serve", action="store_true", help="起 unix socket 服务（systemd 用这个）")
    ap.add_argument("--status", action="store_true", help="打印两颗风扇状态")
    ap.add_argument("--selftest", action="store_true", help="全速 1 秒并读转速")
    ap.add_argument("--stdin", action="store_true", help="从标准输入逐行读 JSON")
    ap.add_argument("--once", metavar="JSON", help="单条请求，打印应答")
    ap.add_argument("-v", "--verbose", action="store_true")
    args = ap.parse_args(argv)

    logging.basicConfig(level=logging.DEBUG if args.verbose else logging.INFO,
                        format="%(levelname)-7s %(name)s: %(message)s")

    helper = Helper(load_config(Path(args.config)))

    euid = getattr(os, "geteuid", lambda: 0)()
    if euid != 0:
        # 只读操作（status）不拦，写操作会在 sysfs 上 EACCES 并给出人话
        log.warning("不是 root：多半只能读，改不了 duty")

    if args.status:
        print(json.dumps({"ok": True, "items": [f.info() for f in helper.fans]},
                         ensure_ascii=False, indent=2))
        return 0
    if args.selftest:
        print(json.dumps(helper.selftest(), ensure_ascii=False, indent=2))
        return 0
    if args.once:
        try:
            req = json.loads(args.once)
        except ValueError as exc:
            print(json.dumps({"ok": False, "error": f"JSON 解析失败：{exc}"}, ensure_ascii=False))
            return 2
        print(json.dumps(safe_handle(helper, req), ensure_ascii=False, indent=2))
        return 0
    if args.stdin:
        for line in sys.stdin:
            line = line.strip()
            if not line:
                continue
            try:
                req = json.loads(line)
            except ValueError as exc:
                res = {"ok": False, "error": f"JSON 解析失败：{exc}"}
            else:
                res = safe_handle(helper, req)
            print(json.dumps(res, ensure_ascii=False), flush=True)
        return 0

    helper.boot_apply()
    asyncio.run(serve(helper))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(0)
